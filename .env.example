# Copy these names into the workspace Secrets panel. Never paste real values here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
GEMINI_API_KEY=your-gemini-api-key
PORT=8000
# Optional Gemini tuning
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=3
# Set to false to disable the server-side MFA level check during development.
REQUIRE_MFA=true
# Set to false to allow anonymous access to protected endpoints (NOT for production).
REQUIRE_AUTH=true
# Public Supabase credentials used by the browser (handled automatically in the
# preview VM via the same-named secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
