# Copy these names into the workspace Secrets panel. Never paste real values here.
# The preview VM already provides SUPABASE_URL, SUPABASE_ANON_KEY and GEMINI_API_KEY.

# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (used by the Python backend and browser).
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for authenticating API keys as bearer tokens on the backend.
# Keep this server-side; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Supabase credentials used by the browser (handled automatically in the
# preview VM via the same-named secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key (server-side only).
GEMINI_API_KEY=your-gemini-api-key

# Port the Gunicorn/Flask service listens on.
PORT=8000

# Optional Gemini tuning.
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=3

# Boolean flags for access control. Accepted values: true / false (case-insensitive).
# REQUIRE_AUTH=true  -> protected endpoints need a valid Supabase access token.
# REQUIRE_AUTH=false -> anonymous requests are allowed (local development only).
REQUIRE_AUTH=true

# REQUIRE_MFA=true  -> authenticated users must have completed MFA (AAL2).
# REQUIRE_MFA=false -> MFA check is skipped.
# Only effective when REQUIRE_AUTH=true.
REQUIRE_MFA=true
